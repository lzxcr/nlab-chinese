    "type": "git",
    "url": "https://github.com/nlab-chinese/nlab-chinese.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "check": "tsc --noEmit && prettier . --check",
    "format": "prettier . --write",
    "test": "tsx --test",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1"
  },
  "engines": {
    "node": ">=22"
