{
  "name": "nlab-chinese",
  "description": "nLab 中英对照站点：自动翻译流水线 + Quartz 静态站点",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "nLab-Chinese contributors",
  "license": "MIT",
  "homepage": "https://nlab-chinese.github.io",
