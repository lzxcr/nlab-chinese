# nLab-Chinese pipeline configuration.
# Copy to .env and adjust as needed.  Every value is optional and falls back
# to the defaults documented in src/nlab_pipeline/config.py.

# --- Paths (defaults are relative to the repository root) ---
# NLAB_DIR=/path/to/nlab-content
# QUARTZ_CONTENT_DIR=/path/to/content
# STATE_FILE=/path/to/state/nlab_state.db        # SQLite state database
# GLOSSARY_FILE=/path/to/nlab_glossary.json      # JSON export of the state db
# DICTIONARY_FILE=/path/to/dictionary.json
# EXTERNAL_GLOSSARY_FILE=/path/to/authorized_external_glossary.json
# NON_TRANSLATABLE_FILE=/path/to/non_translatable.json
# PENDING_REVIEW_FILE=/path/to/pending_review.json
# LOG_DIR=/path/to/logs
# NLAB_BASE_URL=https://ncatlab.org/nlab/show/   # upstream link base

# --- LLM backend ---
# LLM_BACKEND=openai          # "openai" (llama.cpp/OpenAI-compatible) | "ollama"
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=
# LLM_MODEL=gemma-4-12b-it     # model label sent to the server
# LLM_TEMPERATURE=0.0
# LLM_TOP_P=0.1
# LLM_NUM_CTX=8192             # context size sent to Ollama
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT=120

# --- Concurrency ---
# MAX_WORKERS=4

# --- Translation / validation ---
# CHUNK_TARGET_TOKENS=700      # token budget per LLM request
# CHUNK_MAX_TOKENS=900
# VALIDATE_MIN_CJK_RATIO=0.05  # minimum CJK share required to publish a chunk
# MAX_FAIL_COUNT=3             # consecutive failures before needs_review

# --- manage.sh (script layer only) ---
# LLM_MODEL_PATH=/absolute/path/to/model.gguf
# LLM_CTX=4096                 # context window passed to llama-server
# DEPLOY_REMOTE=pages          # explicit remote that receives the gh-pages branch

# --- Quartz site (read by quartz.config.ts / CI) ---
# NLAB_SITE_URL=nlab-chinese.example.org   # canonical host[/base-path] for sitemap/RSS/OG
# NLAB_REPOSITORY_URL=https://github.com/owner/repository  # optional footer source link
# NLAB_OG_IMAGES=1              # set to 0 to disable per-page OG images at scale
